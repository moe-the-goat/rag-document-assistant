# .env.example
# Copy this file to .env and customize as needed.
# Docker Compose automatically reads from .env in the same directory.

# -- Authentication --
# Set a secret key to enable API authentication.
# Leave empty to disable auth (default for local development).
# Both backend and frontend must use the same key.
# API_KEY=your-secret-key-here

# -- File Limits --
# Maximum upload file size in megabytes (default: 50)
# MAX_FILE_SIZE_MB=50

# -- Rate Limiting --
# Max requests per time window for the /ask endpoint (default: 30/minute)
# RATE_LIMIT=30/minute

# -- Logging --
# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
# LOG_LEVEL=INFO
